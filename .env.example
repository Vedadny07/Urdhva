# Optional: deployed FastAPI base URL for GitHub Pages/static hosting.
# Leave empty for local Vite development (the /api proxy targets localhost:8000).
VITE_API_BASE_URL=

# Optional authorized utility GeoJSON adapters
URDHVA_UTILITY_WATER_GEOJSON_URL=
URDHVA_UTILITY_SEWER_GEOJSON_URL=
URDHVA_UTILITY_GAS_GEOJSON_URL=
URDHVA_UTILITY_ELECTRICITY_GEOJSON_URL=
URDHVA_UTILITY_TELECOM_GEOJSON_URL=

# Optional Maharashtra ULPIN/Mahabhumi adapter
MAHABHUMI_ULPIN_API_URL=
MAHABHUMI_ULPIN_API_METHOD=GET
MAHABHUMI_ULPIN_QUERY_PARAM=ulpin
MAHABHUMI_API_KEY=
